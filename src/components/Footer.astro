---
import { INSTAGRAM_URL, LINKEDIN_URL } from "../lib/options.ts";

const copy = { heading: "Write to Tetiana", instagram: "Instagram", linkedin: "LinkedIn" };
const links = [
  { href: INSTAGRAM_URL, label: copy.instagram },
  { href: LINKEDIN_URL, label: copy.linkedin },
];
---

<footer class="mt-16 border-t border-neutral-200 py-10">
  <p class="font-display text-lg font-semibold text-neutral-900">{copy.heading}</p>
  <ul class="mt-3 flex flex-wrap gap-6">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand underline-offset-4 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
          >
            {label} <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</footer>
