---
import BookTrialLink from "./BookTrialLink.astro";

// Interim copy (AC-10: no price, "free", lesson length or learning result). Tetiana approves the
// wording before publishing (release checklist).
const copy = {
  headline: "English lessons with Tetiana",
  sentence: "Individual English lessons for adults and IT professionals.",
};
---

<section class="flex flex-col items-start gap-6 py-16 sm:py-24">
  <img src="/logo.png" alt="EnglishPusher" width="160" height="160" class="h-28 w-auto sm:h-36" />
  <h1 class="font-display text-4xl font-bold leading-tight text-neutral-900 sm:text-5xl">
    {copy.headline}
  </h1>
  <p class="max-w-xl text-lg text-neutral-600">{copy.sentence}</p>
  <BookTrialLink />
</section>
